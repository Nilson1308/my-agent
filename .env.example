DEBUG=True
SECRET_KEY=change-me-to-a-random-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1
# Com cloudflared em DEBUG, .trycloudflare.com já é aceito pelo settings.
# Para /admin via túnel HTTPS, opcional: CSRF_TRUSTED_ORIGINS=https://SEU-HOST.trycloudflare.com

DATABASE_URL=postgresql://my_agent:my_agent@localhost:5432/my_agent

# Produção (Docker Compose): use host `db` e `redis`
# DATABASE_URL=postgresql://my_agent:my_agent@db:5432/my_agent
# REDIS_URL=redis://redis:6379/0

REDIS_URL=redis://localhost:6379/0

POSTGRES_DB=my_agent
POSTGRES_USER=my_agent
POSTGRES_PASSWORD=my_agent

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
# Opcional: se api.telegram.org não conectar (rede/firewall)
# TELEGRAM_PROXY_URL=socks5://127.0.0.1:1080
TELEGRAM_BOOTSTRAP_RETRIES=-1

GROQ_API_KEY=
GROQ_LLM_MODEL=openai/gpt-oss-120b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

GEOFENCE_WEBHOOK_TOKEN=
# Leitura PWA (GET /api/pwa/snapshot/)
PWA_API_TOKEN=
# Máx. requisições PATCH/POST /api/pwa/* por IP por minuto (0 = desliga)
PWA_WRITE_RATE_LIMIT_PER_MINUTE=60
# Rotação sem downtime: token antigo aqui enquanto aparelhos migram
# PWA_API_TOKEN_PREVIOUS=
# Base pública do PWA (URLs de pairing/QR)
PWA_PUBLIC_BASE_URL=https://copa.mogidascruzes.sp.gov.br/app
PWA_PAIRING_TTL_SECONDS=900
# Web Push (python manage.py generate_vapid_keys)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_ADMIN_EMAIL=mailto:admin@localhost
# Mínimo entre dois disparos do geofence por IP (0 = desliga)
GEOFENCE_RATE_LIMIT_SECONDS=120

EVENT_REMINDER_MINUTES_BEFORE=30
EVENT_REMINDER_WINDOW_MINUTES=8

TTS_ENABLED=True
TTS_VOICE=pt-BR-AntonioNeural
TTS_MAX_CHARS=900